from pathlib import Path

p = Path("third_party/Hunyuan3D-2/hy3dgen/shapegen/pipelines.py")
s = p.read_text()

backup = p.with_suffix(".py.backup_before_clean_conflicting_exports")
backup.write_text(s)
print("[OK] backup:", backup)

markers = [
    "FOHO_INTERNAL_SELECTOR_EXACT_EXPORT_V3",
    "FOHO_INTERNAL_SELECTOR_EXACT_EXPORT_V4",
]

lines = s.splitlines()
out = []
i = 0
removed = 0

while i < len(lines):
    line = lines[i]

    if any(m in line for m in markers):
        removed += 1
        indent = len(line) - len(line.lstrip())

        # Skip this try/except export block conservatively until indentation returns.
        i += 1
        while i < len(lines):
            cur = lines[i]
            cur_indent = len(cur) - len(cur.lstrip()) if cur.strip() else 999

            if cur.strip() and cur_indent <= indent and not cur.lstrip().startswith(("except", "else")):
                break
            i += 1
        continue

    out.append(line)
    i += 1

s2 = "\n".join(out) + "\n"

p.write_text(s2)
print("[OK] removed conflicting export marker blocks:", removed)
