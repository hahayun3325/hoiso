{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["decision", "selected_candidate_id", "physical_hand", "handedness", "confidence", "reasons"],
  "properties": {
    "decision": {"enum": ["select", "hold"]},
    "selected_candidate_id": {"type": ["string", "null"]},
    "physical_hand": {"const": "upper"},
    "handedness": {"enum": ["left", "right", "uncertain"]},
    "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "reasons": {"type": "array", "items": {"type": "string"}, "minItems": 1}
  },
  "additionalProperties": false
}
