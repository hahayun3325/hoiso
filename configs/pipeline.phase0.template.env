# FollowMyHold pipeline configuration
# Copy this file and edit for your environment.

# Project roots
PROJECT_ROOT="/home/fredcui/Projects/FollowMyHold"

# Conda setup
CONDA_SH="/home/fredcui/anaconda3/etc/profile.d/conda.sh"
ENV_NAME="foho"
# Optional: explicit env prefix if CONDA_PREFIX is not set at runtime
# ENV_PREFIX="/path/to/miniforge3/envs/foho"
# Optional: override CUDA toolkit path
# CUDA_HOME="/usr/local/cuda"

# Dataset
BASE_DIR="/home/fredcui/foho_phase0/runs/smoke_001"

# Auth / model caches
GEMINI_API_KEY="PASTE_GEMINI_API_KEY_HERE"
HF_TOKEN="PASTE_HF_TOKEN_HERE"
HY3DGEN_MODELS="/home/fredcui/foho_phase0/cache/hy3dgen"

# Input
IMAGE_PATH="/home/fredcui/foho_phase0/inputs/test_hoi_ho3d_ShSu13_0005.png"

# Optional overrides for derived paths
# ORIGINAL_IMG_DIR="${BASE_DIR}/original_imgs"
# MASKED_OBJ_PATH="${BASE_DIR}/masked_obj_imgs"
# CROPPED_HOI_PATH="${BASE_DIR}/cropped_hoi_imgs"
# CROPPED_HOI_WO_BCKG_PATH="${BASE_DIR}/cropped_hoi_imgs_wo_bckg"
# CROPPED_INPAINTED_OBJ="${BASE_DIR}/ours_inpaint"
# MASK_DIR_PATH="${BASE_DIR}/cropped_hand_masks"
# MOGE_OUT_PATH="${BASE_DIR}/moge_out"
# HUNYUAN_HOI_MESH_PATH="${BASE_DIR}/hunyuan_hoi_out"
# HAMER_OUT_PATH="${BASE_DIR}/hamer_out"
# H2M_RT_PATH="${BASE_DIR}/h2m_transformations"
# ALIGNED_MANO_PATH="${BASE_DIR}/aligned_mano"
# GUIDANCE_OUT_PATH="${BASE_DIR}/guidance_out"

# Toggle steps
RUN_INPAINT=1

# Warning controls
# Set to 0 to show FutureWarning/UserWarning output from third-party libs.
FOHO_SUPPRESS_WARNINGS=1

# Debug outputs (optional)
# If set, Hy3DGen will write extra debug artifacts to this directory.
# FOHO_DEBUG_DIR="/tmp/foho_debug"

FOHO_DETERMINISTIC=1

FOHO_DEBUG_DIR="/home/fredcui/foho_phase0/runs/smoke_001/foho_debug"
